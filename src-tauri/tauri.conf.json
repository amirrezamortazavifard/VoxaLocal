{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxaLocal",
  "version": "1.0.2",
  "identifier": "com.voxlocal.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxaLocal — Offline Persian & English Speech Recognition Studio",
        "width": 780,
        "height": 560,
        "minWidth": 780,
        "minHeight": 560,
        "maxWidth": 780,
        "maxHeight": 560,
        "resizable": false,
        "center": true,
        "decorations": false
      },
      {
        "label": "quick-dictation",
        "title": "VoxaLocal Quick Dictation",
        "url": "index.html?window=quick-dictation",
        "width": 560,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "models/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}