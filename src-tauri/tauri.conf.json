{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxaLocal",
  "version": "0.1.0",
  "identifier": "com.voxlocal.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxaLocal — Offline Persian & English Speech Recognition Studio",
        "width": 1200,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "decorations": true
      },
      {
        "label": "quick-dictation",
        "title": "VoxaLocal Quick Dictation",
        "url": "index.html?window=quick-dictation",
        "width": 620,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
